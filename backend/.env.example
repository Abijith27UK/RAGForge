# RAGForge backend configuration (copy to .env and adjust)
# All values are optional; defaults are shown.

# URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM provider: openai | gemini | anthropic | mock
#   openai   - OpenAI or any OpenAI-compatible server (set LLM_BASE_URL)
#   gemini   - Google, via its OpenAI-compatible surface (V20). LLM_BASE_URL
#              defaults to https://generativelanguage.googleapis.com/v1beta/openai/
#              and LLM_MODEL should be an id your key can see:
#              GET https://generativelanguage.googleapis.com/v1beta/openai/models
#   mock     - the deterministic dev generator (is_mock=true is reported)
#   anthropic- NOT implemented: no OpenAI-compatible surface exists there
# empty = dev mock, clearly labelled in output
# NOTE: with openai/gemini configured, answers make REAL external calls. Never
# commit a key, and rotate any key that has been shared or printed.
LLM_PROVIDER=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
# Set false to fail hard when no LLM is configured (no silent mock mode)
ALLOW_MOCK_LLM=true
# V19: per-call budget for the LLM client (seconds / automatic retries).
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2

# Embeddings: sentence-transformers | openai | hashing-dev-fallback
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_API_KEY=

# Retrieval
DEFAULT_TOP_K=5

# --- V20: grounding-gate relevance floor ---
# Top retrieved-chunk similarity below which nothing is treated as topically
# related to the question, so the answer abstains instead of grounding an
# off-domain question on generic word overlap. Default 0.35 is MEASURED on the
# protected Automobile corpus with sentence-transformers/all-MiniLM-L6-v2
# (off-domain max 0.3411, in-domain min 0.4365). It is a cosine scale, so
# RECALIBRATE when EMBEDDING_MODEL changes:
#   backend\scripts20_calibrate_relevance.py --kb <kb_id>
# Applies only to strategies reporting an unnormalized similarity (dense) and
# only to semantic embeddings; the run records the check as NOT APPLICABLE
# otherwise. See docs/v20-offdomain-gate.md.
ANSWER_MIN_RELEVANCE=0.35

# --- User document ingestion (V4) ---
# Max size of a single uploaded file, in bytes (default 100 MB).
MAX_UPLOAD_BYTES=104857600
# Max files per upload request (default 50).
MAX_UPLOAD_FILES_PER_REQUEST=50
# Privacy: uploaded files may be private course material. Parsing, chunking and
# embedding are LOCAL by default. Set this to true ONLY after explicitly
# deciding that user documents may be sent to an external service.
ALLOW_EXTERNAL_LLM_FOR_USER_DOCUMENTS=false