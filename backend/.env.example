# RAGForge backend configuration (copy to .env and adjust)
# All values are optional; defaults are shown.

# URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM provider: openai | mock  (empty = dev mock, clearly labelled in output)
LLM_PROVIDER=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
# Set false to fail hard when no LLM is configured (no silent mock mode)
ALLOW_MOCK_LLM=true

# Embeddings: sentence-transformers | openai | hashing-dev-fallback
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_API_KEY=

# Retrieval
DEFAULT_TOP_K=5
